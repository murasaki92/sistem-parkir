# Optional — semua nilai punya default yang aman untuk development.

# Lokasi database + secret sesi (default: ./data)
# PARKLINE_DATA_DIR=/var/lib/parkline

# Wajib diisi di produksi. String acak panjang.
# PARKLINE_SECRET=ganti-dengan-string-acak-panjang

# Set 1 jika aplikasi diakses lewat HTTPS.
# PARKLINE_SECURE_COOKIE=1

# Password admin saat database pertama kali dibuat.
# PARKLINE_ADMIN_PASSWORD=password-admin-yang-kuat

# Set false untuk instalasi produksi tanpa akun/perangkat/tiket demo.
# PARKLINE_SEED_DEMO=false
